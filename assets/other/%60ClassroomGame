    <script>
      // Pre-paint favicon swap for the new-brand (ds-homepage) cohort: on a hard
      // navigation (e.g. login → homepage) the document reloads with the legacy
      // icon above and would flash it until React mounts and DsBrandFavicon runs.
      // DsBrandFavicon persists this localStorage flag only when ds-homepage is on,
      // so the excluded cohort never sets it and this stays a no-op (legacy icon
      // preserved). The swap target is an inline data: URI (not the CDN URL): a
      // remote favicon is fetched async, so the browser keeps painting the legacy
      // icon until it arrives — the exact flash this removes. The data URI renders
      // synchronously with no request. Keep byte-identical with BRAND_FAVICON_SRC
      // in src/constants/brandAssets.ts.
      try {
        if (localStorage.getItem('b44-ds-brand-favicon') === '1') {
          var b44Icon = document.querySelector('link[rel="icon"]');
          if (b44Icon) {
            b44Icon.setAttribute('href', 'data:image/png;base64,');
            b44Icon.setAttribute('type', 'image/png');
          }
        }
      } catch (e) {}
